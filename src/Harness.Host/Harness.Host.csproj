<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>43cfafb2-a39f-4693-94fe-4571dc85469c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- CAT-06: import/export de definições de agente em YAML, reutilizando a mesma
         biblioteca (versão gerida centralmente) já usada pelo módulo de Governança. -->
    <PackageReference Include="YamlDotNet" />
    <!-- B6/F15: o índice de grafo de código mora aqui, junto do resto do serviço de Architecture
         (ArchitectureSelfMapSeeder, ArchitectureReadModelService), porque é o Host que faz I/O. Os
         consumidores (políticas em Modules.Coordination) só veem a abstração em SharedKernel, então
         Roslyn NÃO entra em nenhum módulo de domínio nem no Runner. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seam de teste: a prova determinística do dispatch do Chefe roda UM ciclo do loop e
         inspeciona o par (despachados, adiados). Só expõe o membro interno aos testes. -->
    <InternalsVisibleTo Include="Harness.IntegrationTests" />
    <InternalsVisibleTo Include="Harness.UnitTests" />
    <InternalsVisibleTo Include="Harness.RecoveryTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../governance/**" Link="governance/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/**" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../AGENTS.md" Link="AGENTS.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../CLAUDE.md" Link="CLAUDE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
