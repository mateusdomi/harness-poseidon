<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>43cfafb2-a39f-4693-94fe-4571dc85469c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../governance/**" Link="governance/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/**" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../AGENTS.md" Link="AGENTS.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../CLAUDE.md" Link="CLAUDE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
