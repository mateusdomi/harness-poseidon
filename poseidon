#!/usr/bin/env bash
set -euo pipefail

readonly POSEIDON_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly POSEIDON_DATA_DIR="${POSEIDON_DATA_DIR:-${HOME}/.harness-poseidon}"
readonly POSEIDON_RUNTIME_DIR="${POSEIDON_DATA_DIR}/runtime"
readonly POSEIDON_STATE_FILE="${POSEIDON_RUNTIME_DIR}/poseidon.json"
readonly POSEIDON_LOG_DIR="${POSEIDON_DATA_DIR}/logs"
readonly POSEIDON_HOST_LOG="${POSEIDON_LOG_DIR}/poseidon.log"
# PORTA-DINAMICA: porta fixa persistida no primeiro start (gravada pelo Launcher).
readonly POSEIDON_PORT_FILE="${POSEIDON_DATA_DIR}/port"

# Teto do log do Host, em bytes (padrão 64 MB). O log é append-only entre execuções e nada o
# truncava: numa máquina de homologação ele passou de 400 MB em poucos dias, e a partir daí cada
# consulta a ele — inclusive a do próprio operador tentando entender uma falha — ficou lenta ou
# impossível. Rotacionar no start mantém a última execução inteira e uma anterior de referência.
readonly POSEIDON_LOG_MAX_BYTES="${POSEIDON_LOG_MAX_BYTES:-67108864}"

rotate_host_log() {
  mkdir -p "${POSEIDON_LOG_DIR}"
  [[ -f "${POSEIDON_HOST_LOG}" ]] || return 0
  local size
  size="$(wc -c <"${POSEIDON_HOST_LOG}" 2>/dev/null | tr -d ' ')" || return 0
  [[ -n "${size}" && "${size}" -gt "${POSEIDON_LOG_MAX_BYTES}" ]] || return 0
  # Uma geração anterior basta: guardar mais devolveria o mesmo problema com outro nome.
  mv -f "${POSEIDON_HOST_LOG}" "${POSEIDON_HOST_LOG}.1" 2>/dev/null || return 0
  echo "Log anterior arquivado em ${POSEIDON_HOST_LOG}.1 (passou de ${POSEIDON_LOG_MAX_BYTES} bytes)."
}

usage() {
  echo "Uso: ./poseidon {start|status|stop|restart|doctor|logs|check-update|update|bruna|agent|agents|chief|graph|tools|release-candidate} [opções]"
  echo "  start [--no-browser] [--no-bruna] [--port PORT] [--demo]"
  echo "  check-update [--source <dir-do-pacote-novo>]"
  echo "  update [--source <dir-do-pacote-novo>]"
  echo "  logs [--follow]"
  echo "  bruna [--data-dir <caminho>]"
  echo "  agent start --project <id> --task <id> --role <papel>"
  echo "              --account <alias> --instruction <texto>"
  echo "              [--attempt <id>] [--resume-from <attemptId>] [--model <m>] [--effort <e>] [--read-only]"
  echo "  agent status <attemptId>"
  echo "  agent cancel <attemptId>"
  echo "  agent review <attemptId> --critic <alias> --actor <alias> --diff-file <arquivo>"
  echo "                [--tests-file <arquivo>] [--scope <glob>] [--criterion <texto>]"
  echo "  agent recover"
  echo "  agent doctor"
  echo "  agents list"
  echo "  agents add <claude|codex> <account-id> [--role executor|chief|critic]"
  echo "  agents auth <account-id>"
  echo "  agents logout <account-id>"
  echo "  agents probe <account-id>"
  echo "  agents status <account-id>"
  echo "  agents disable <account-id>"
  echo "  agents enable <account-id>"
  echo "  chief set <account-id>"
  echo "  tools e2e"
}

json_number() {
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "${POSEIDON_STATE_FILE}" | head -1
}

json_string() {
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "${POSEIDON_STATE_FILE}" | head -1
}

launcher_pid() {
  [[ -s "${POSEIDON_STATE_FILE}" ]] && json_number launcherPid || true
}

is_running() {
  local pid
  pid="$(launcher_pid)"
  [[ -n "${pid}" ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  case "$(ps -p "${pid}" -o command= 2>/dev/null)" in
    *Harness.Launcher*) return 0 ;;
    *) return 1 ;;
  esac
}

operational_probe() {
  local address="$1"
  local cookie_jar body status endpoint method expected mode
  POSEIDON_PROBE_ERROR=""
  mkdir -p "${POSEIDON_RUNTIME_DIR}"
  cookie_jar="$(mktemp "${POSEIDON_RUNTIME_DIR}/doctor-cookies.XXXXXX")"
  body="$(mktemp "${POSEIDON_RUNTIME_DIR}/doctor-body.XXXXXX")"
  chmod 600 "${cookie_jar}" "${body}"

  probe_request() {
    method="$1" endpoint="$2" expected="$3"
    status="$(curl --silent --show-error --max-time 3 \
      --request "${method}" --cookie "${cookie_jar}" --cookie-jar "${cookie_jar}" \
      --output "${body}" --write-out '%{http_code}' "${address}${endpoint}" 2>/dev/null || true)"
    if [[ "${status}" != "${expected}" ]]; then
      POSEIDON_PROBE_ERROR="${method} ${endpoint%%\?*} retornou ${status:-sem resposta}; esperado ${expected}"
      return 1
    fi
    if [[ "${endpoint}" != "/" ]] && ! LC_ALL=C grep -Eq '^[[:space:]]*[\{\[]' "${body}"; then
      POSEIDON_PROBE_ERROR="${method} ${endpoint%%\?*} não retornou JSON válido"
      return 1
    fi
  }

  if ! probe_request GET "health" 200 ||
     ! probe_request GET "api/v1/profiles?limit=1" 200; then
    unlink "${cookie_jar}"
    unlink "${body}"
    return 1
  fi
  if LC_ALL=C grep -Eq '"items"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]' "${body}"; then
    mode="onboarding"
    probe_request GET "api/v1/profiles/current" 404 || { unlink "${cookie_jar}"; unlink "${body}"; return 1; }
    probe_request GET "api/v1/projects?limit=1" 401 || { unlink "${cookie_jar}"; unlink "${body}"; return 1; }
  else
    mode="personal-session"
    for endpoint in \
      "api/v1/profiles/current" \
      "api/v1/organizations?limit=1" \
      "api/v1/projects?limit=1" \
      "api/v1/budgets?limit=1" \
      "api/v1/audit-events?limit=1"; do
      probe_request GET "${endpoint}" 200 || { unlink "${cookie_jar}"; unlink "${body}"; return 1; }
    done
  fi
  probe_request GET "api/v1/event-streams/snapshot?stream=global&afterSequence=0" 200 || {
    unlink "${cookie_jar}"; unlink "${body}"; return 1;
  }
  probe_request POST "hubs/events/negotiate?negotiateVersion=1" 200 || {
    unlink "${cookie_jar}"; unlink "${body}"; return 1;
  }
  unlink "${cookie_jar}"
  unlink "${body}"
  POSEIDON_PROBE_MODE="${mode}"
}

recover_stale_state() {
  if [[ -f "${POSEIDON_STATE_FILE}" ]] && ! is_running; then
    unlink "${POSEIDON_STATE_FILE}"
    [[ ! -f "${POSEIDON_RUNTIME_DIR}/runner.token" ]] || unlink "${POSEIDON_RUNTIME_DIR}/runner.token"
  fi
}

resolve_launcher() {
  if [[ -x "${POSEIDON_ROOT}/Harness.Launcher" ]]; then
    echo "${POSEIDON_ROOT}/Harness.Launcher"
    return
  fi
  [[ -x "${POSEIDON_ROOT}/tools/backend/dotnet.sh" ]] || {
    echo "Pacote inválido: Harness.Launcher não encontrado." >&2
    exit 2
  }
  command -v node >/dev/null || { echo "Node.js é obrigatório no modo de desenvolvimento." >&2; exit 2; }
  "${POSEIDON_ROOT}/tools/backend/dotnet.sh" --info >/dev/null || {
    echo "SDK .NET versionado inválido." >&2
    exit 2
  }
  "${POSEIDON_ROOT}/tools/backend/build-frontend.sh" >/dev/null || {
    echo "Os gates do frontend falharam; a inicialização foi cancelada." >&2
    exit 2
  }
  "${POSEIDON_ROOT}/tools/backend/dotnet.sh" build \
    "${POSEIDON_ROOT}/src/Harness.Launcher/Harness.Launcher.csproj" --configuration Release -nr:false -p:UseSharedCompilation=false >/dev/null || {
      echo "Falha ao compilar o Launcher." >&2
      exit 2
    }
  "${POSEIDON_ROOT}/tools/backend/dotnet.sh" build \
    "${POSEIDON_ROOT}/src/Harness.Runner/Harness.Runner.csproj" --configuration Release -nr:false -p:UseSharedCompilation=false >/dev/null || {
      echo "Falha ao compilar o Runner." >&2
      exit 2
    }
  # O HOST precisa ser compilado explicitamente.
  #
  # Launcher e Runner referenciam o Host, mas o build incremental do .NET nem sempre o reconstrói
  # quando só o Host mudou — e o efeito é traiçoeiro: `./poseidon start` termina verde, o produto
  # sobe, e o binário em execução é de dias atrás. Foi assim que uma correção de sandbox parecia
  # não funcionar por horas: ela nunca chegou ao processo que estava rodando.
  "${POSEIDON_ROOT}/tools/backend/dotnet.sh" build \
    "${POSEIDON_ROOT}/src/Harness.Host/Harness.Host.csproj" --configuration Release -nr:false -p:UseSharedCompilation=false >/dev/null || {
      echo "Falha ao compilar o Host." >&2
      exit 2
    }
  local candidate="${POSEIDON_ROOT}/src/Harness.Launcher/bin/Release/net10.0/Harness.Launcher"
  [[ -x "${candidate}" ]] || { echo "Falha ao preparar o Launcher." >&2; exit 2; }
  echo "${candidate}"
}

bruna_is_running() {
  pgrep -f "Harness\.Bruna\.Desktop.*--data-dir ${POSEIDON_DATA_DIR}" >/dev/null 2>&1
}

start_poseidon() {
  [[ "$(uname -s)" == "Darwin" ]] || { echo "Este candidato suporta inicialização local no macOS." >&2; exit 2; }
  if [[ -x "${POSEIDON_ROOT}/Harness.Launcher" && "$(uname -m)" != "arm64" ]]; then
    echo "Pacote incompatível: esta candidata osx-arm64 exige Mac Apple Silicon." >&2
    exit 2
  fi
  recover_stale_state
  if is_running; then
    echo "Poseidon já está em execução em $(json_string address)"
    bruna_is_running || bruna_poseidon
    return
  fi
  local open_browser=true port="" demo=false no_bruna=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-browser) open_browser=false ;;
      --no-bruna) no_bruna=true ;;
      --demo) demo=true ;;
      --port) [[ $# -ge 2 ]] || { echo "--port exige um valor." >&2; exit 2; }; port="$2"; shift ;;
      *) echo "Opção desconhecida: $1" >&2; exit 2 ;;
    esac
    shift
  done
  [[ -z "${port}" || "${port}" =~ ^[0-9]+$ ]] || { echo "Porta inválida." >&2; exit 2; }
  if [[ -n "${port}" ]] && lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "A porta ${port} já está em uso." >&2
    exit 2
  fi
  mkdir -p "${POSEIDON_RUNTIME_DIR}" "${POSEIDON_LOG_DIR}"
  # Carrega a config de ORQUESTRAÇÃO e os segredos do operador FORA do repositório. É o que
  # torna o core de orquestração (agent-runs, registro das contas) carregado logo na
  # inicialização, sem env vars manuais. `poseidon.env` habilita agent-runs e aponta o
  # ControlledRoot/ProfilesRoot/AccountsFilePath; ele mesmo carrega `glm.env` (token GLM
  # resolvido do Keychain, nunca em texto). Nenhum arquivo é versionado; nenhum segredo
  # trafega em texto. Só executores cujo allowlist inclui ANTHROPIC_* herdam o token GLM
  # (o provisionador zera o ambiente por conta), então as contas Claude reais não são afetadas.
  set -a
  for _env in "${HOME}/.harness/poseidon.env" "${HOME}/.harness/glm.env"; do
    if [[ -f "${_env}" ]]; then
      # shellcheck disable=SC1090
      source "${_env}" || true
    fi
  done
  set +a
  rotate_host_log
  local launcher
  launcher="$(resolve_launcher)"
  local args=(--data-dir "${POSEIDON_DATA_DIR}" --no-browser)
  [[ -z "${port}" ]] || args+=(--port "${port}")
  local process_id="" detached_with_screen=false
  if command -v screen >/dev/null 2>&1; then
    local screen_name="poseidon-launcher"
    screen -S "${screen_name}" -X quit >/dev/null 2>&1 || true
    if [[ "${demo}" == true ]]; then
      screen -S "${screen_name}" -dm bash -c 'export Harness__Demo__Enabled=true; log="$1"; shift; exec "$@" </dev/null >>"$log" 2>&1' _ "${POSEIDON_HOST_LOG}" "${launcher}" "${args[@]}"
    else
      screen -S "${screen_name}" -dm bash -c 'log="$1"; shift; exec "$@" </dev/null >>"$log" 2>&1' _ "${POSEIDON_HOST_LOG}" "${launcher}" "${args[@]}"
    fi
    detached_with_screen=true
  else
    if [[ "${demo}" == true ]]; then
      Harness__Demo__Enabled=true nohup "${launcher}" "${args[@]}" </dev/null >>"${POSEIDON_HOST_LOG}" 2>&1 &
    else
      nohup "${launcher}" "${args[@]}" </dev/null >>"${POSEIDON_HOST_LOG}" 2>&1 &
    fi
    process_id=$!
    disown "${process_id}" 2>/dev/null || true
  fi
  for _ in {1..120}; do
    if [[ -s "${POSEIDON_STATE_FILE}" ]]; then
      local address
      address="$(json_string address)"
      if operational_probe "${address}"; then
        echo "Poseidon disponível em ${address} (readiness: ${POSEIDON_PROBE_MODE})"
        echo "Dados: ${POSEIDON_DATA_DIR}"
        echo "Logs: ${POSEIDON_LOG_DIR}"
        [[ "${open_browser}" != true ]] || /usr/bin/open "${address}"
        [[ "${no_bruna}" == true ]] || bruna_is_running || bruna_poseidon
        return
      fi
    fi
    if [[ "${detached_with_screen}" != true ]] && ! kill -0 "${process_id}" 2>/dev/null; then
      echo "O Launcher encerrou durante a inicialização. Consulte ${POSEIDON_HOST_LOG}." >&2
      exit 2
    fi
    sleep 0.25
  done
  if [[ "${detached_with_screen}" == true ]]; then
    screen -S poseidon-launcher -X quit >/dev/null 2>&1 || true
  else
    kill "${process_id}" 2>/dev/null || true
  fi
  echo "Timeout ao iniciar. Consulte ${POSEIDON_HOST_LOG}." >&2
  exit 2
}

stop_poseidon() {
  recover_stale_state
  if ! is_running; then echo "Poseidon já está parado."; return; fi
  local pid
  pid="$(launcher_pid)"
  kill -TERM "${pid}"
  for _ in {1..80}; do
    kill -0 "${pid}" 2>/dev/null || { echo "Poseidon encerrado."; return; }
    sleep 0.25
  done

  # O shutdown gracioso não terminou em 20 segundos.
  #
  # Antes, aqui o processo era PRESERVADO e o comando saía com erro. A intenção era boa —
  # guardar o estado para diagnóstico — mas o efeito prático era o oposto: `stop; start`, que
  # é o jeito natural de reiniciar, encontrava o processo ainda vivo, imprimia "já está em
  # execução" e desistia; segundos depois ele morria e o Poseidon ficava FORA DO AR com uma
  # mensagem dizendo que estava no ar. Um `stop` que não para é pior que um `stop` bruto.
  #
  # Agora escala para SIGKILL, avisando o que foi feito e onde olhar. O trabalho não se perde:
  # o motor é durável e a recuperação na subida reconcilia tentativa órfã.
  echo "Shutdown gracioso excedeu 20s; encerrando à força (SIGKILL)." >&2
  echo "Diagnóstico em ${POSEIDON_LOG_DIR}." >&2
  kill -KILL "${pid}" 2>/dev/null || true
  for _ in {1..40}; do
    kill -0 "${pid}" 2>/dev/null || { echo "Poseidon encerrado à força."; return; }
    sleep 0.25
  done

  echo "Não foi possível encerrar o processo ${pid}." >&2
  exit 2
}

# ---------------------------------------------------------------------------
# Bootstrap governado de agentes (CA-5).
#
# Estes verbos NÃO executam agente por conta própria: eles falam com a API
# oficial do Host, que é quem detém claim, conta, worktree, bundle e receipt.
# Não existe caminho paralelo que contorne a governança.
# ---------------------------------------------------------------------------

agent_cookie_jar() {
  mkdir -p "${POSEIDON_RUNTIME_DIR}"
  local jar="${POSEIDON_RUNTIME_DIR}/agent-cookies"
  if [[ ! -f "${jar}" ]]; then
    : > "${jar}"
    chmod 600 "${jar}"
  fi
  echo "${jar}"
}

agent_request() {
  local method="$1" endpoint="$2" payload="${3:-}"
  local address jar status body
  if ! is_running; then
    echo "Poseidon está parado. Execute './poseidon start' antes." >&2
    return 1
  fi
  address="$(json_string address)"
  jar="$(agent_cookie_jar)"
  body="$(mktemp "${POSEIDON_RUNTIME_DIR}/agent-body.XXXXXX")"
  chmod 600 "${body}"

  # Estabelece a sessão pessoal antes de qualquer comando governado.
  curl --silent --show-error --max-time 10 --cookie "${jar}" --cookie-jar "${jar}" \
    --output /dev/null "${address}api/v1/profiles/current" 2>/dev/null || true

  if [[ -n "${payload}" ]]; then
    status="$(curl --silent --show-error --max-time 600 --request "${method}" \
      --cookie "${jar}" --cookie-jar "${jar}" \
      --header 'Content-Type: application/json' --data "${payload}" \
      --output "${body}" --write-out '%{http_code}' "${address}${endpoint}" || true)"
  else
    status="$(curl --silent --show-error --max-time 600 --request "${method}" \
      --cookie "${jar}" --cookie-jar "${jar}" \
      --output "${body}" --write-out '%{http_code}' "${address}${endpoint}" || true)"
  fi

  if command -v python3 >/dev/null 2>&1; then
    python3 -m json.tool "${body}" 2>/dev/null || cat "${body}"
  else
    cat "${body}"
  fi
  echo
  unlink "${body}"
  case "${status}" in
    2*) return 0 ;;
    *) echo "HTTP ${status:-sem resposta}" >&2; return 1 ;;
  esac
}

agent_json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

agent_start() {
  local project="" task="" role="" account="" instruction="" attempt="" resume_from="" model="" effort=""
  local read_only=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --task) task="$2"; shift 2 ;;
      --role) role="$2"; shift 2 ;;
      --account) account="$2"; shift 2 ;;
      --instruction) instruction="$2"; shift 2 ;;
      --attempt) attempt="$2"; shift 2 ;;
      --resume-from) resume_from="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --effort) effort="$2"; shift 2 ;;
      --read-only) read_only=true; shift ;;
      *) echo "Opção desconhecida: $1" >&2; return 2 ;;
    esac
  done

  for required in project task role account instruction; do
    if [[ -z "${!required}" ]]; then
      echo "--${required} é obrigatório." >&2
      usage >&2
      return 2
    fi
  done

  local payload
  payload="{\"projectId\":$(agent_json_escape "${project}")"
  payload="${payload},\"taskId\":$(agent_json_escape "${task}")"
  payload="${payload},\"role\":$(agent_json_escape "${role}")"
  payload="${payload},\"account\":$(agent_json_escape "${account}")"
  payload="${payload},\"instruction\":$(agent_json_escape "${instruction}")"
  [[ -z "${attempt}" ]] || payload="${payload},\"attemptId\":$(agent_json_escape "${attempt}")"
  [[ -z "${resume_from}" ]] || payload="${payload},\"resumeFromAttemptId\":$(agent_json_escape "${resume_from}")"
  [[ -z "${model}" ]] || payload="${payload},\"model\":$(agent_json_escape "${model}")"
  [[ -z "${effort}" ]] || payload="${payload},\"effort\":$(agent_json_escape "${effort}")"
  [[ "${read_only}" != true ]] || payload="${payload},\"readOnly\":true"
  payload="${payload}}"

  agent_request POST "api/v1/agent-runs" "${payload}"
}

agent_review() {
  local attempt="${1:-}"; [[ -n "${attempt}" ]] || { echo "Uso: ./poseidon agent review <attemptId> --critic <alias> --actor <alias> --diff-file <arquivo>" >&2; return 2; }
  shift
  local critic="" actor="" diff_file="" tests_file="" scopes=() criteria=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --critic) critic="$2"; shift 2 ;;
      --actor) actor="$2"; shift 2 ;;
      --diff-file) diff_file="$2"; shift 2 ;;
      --tests-file) tests_file="$2"; shift 2 ;;
      --scope) scopes+=("$2"); shift 2 ;;
      --criterion) criteria+=("$2"); shift 2 ;;
      *) echo "Opção desconhecida: $1" >&2; return 2 ;;
    esac
  done
  for required in critic actor diff_file; do
    [[ -n "${!required}" ]] || { echo "--${required//_/-} é obrigatório." >&2; return 2; }
  done
  [[ -f "${diff_file}" ]] || { echo "Arquivo de diff não encontrado: ${diff_file}" >&2; return 2; }

  local payload
  payload="$(POSEIDON_CRITIC="${critic}" POSEIDON_ACTOR="${actor}" \
    POSEIDON_DIFF_FILE="${diff_file}" POSEIDON_TESTS_FILE="${tests_file}" \
    POSEIDON_SCOPES="$(printf '%s\n' "${scopes[@]+"${scopes[@]}"}")" \
    POSEIDON_CRITERIA="$(printf '%s\n' "${criteria[@]+"${criteria[@]}"}")" \
    python3 -c '
import json, os
scopes = [s for s in os.environ.get("POSEIDON_SCOPES", "").split("\n") if s]
criteria = [c for c in os.environ.get("POSEIDON_CRITERIA", "").split("\n") if c]
body = {
    "critic": os.environ["POSEIDON_CRITIC"],
    "actor": os.environ["POSEIDON_ACTOR"],
    "diff": open(os.environ["POSEIDON_DIFF_FILE"], encoding="utf-8", errors="replace").read(),
    "acceptanceCriteria": criteria,
    "scopeClaims": scopes,
}
tests = os.environ.get("POSEIDON_TESTS_FILE")
if tests:
    body["testEvidence"] = open(tests, encoding="utf-8", errors="replace").read()
print(json.dumps(body))
')"
  agent_request POST "api/v1/agent-runs/${attempt}/review" "${payload}"
}

graph_poseidon() {
  local verb="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "${verb}" in
    rebuild)
      [[ -n "${1:-}" ]] || { echo "Uso: ./poseidon graph rebuild <projectId>" >&2; return 2; }
      agent_request POST "api/v1/projects/$1/graph/rebuild" ;;
    show)
      [[ -n "${1:-}" ]] || { echo "Uso: ./poseidon graph show <projectId>" >&2; return 2; }
      agent_request GET "api/v1/projects/$1/graph" ;;
    *) echo "Uso: ./poseidon graph {rebuild|show} <projectId>" >&2; return 2 ;;
  esac
}

agent_poseidon() {
  local verb="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "${verb}" in
    start) agent_start "$@" ;;
    status)
      [[ -n "${1:-}" ]] || { echo "Uso: ./poseidon agent status <attemptId>" >&2; return 2; }
      agent_request GET "api/v1/agent-runs/$1" ;;
    cancel)
      [[ -n "${1:-}" ]] || { echo "Uso: ./poseidon agent cancel <attemptId>" >&2; return 2; }
      agent_request POST "api/v1/agent-runs/$1/cancel" ;;
    review) agent_review "$@" ;;
    recover) agent_request POST "api/v1/agent-runs/recovery" ;;
    doctor) agent_request GET "api/v1/agent-accounts/doctor" ;;
    *) usage >&2; return 2 ;;
  esac
}

agents_poseidon() {
  [[ -x "${POSEIDON_ROOT}/tools/backend/agent_accounts.py" ]] || chmod +x "${POSEIDON_ROOT}/tools/backend/agent_accounts.py"
  "${POSEIDON_ROOT}/tools/backend/agent_accounts.py" "$@"
}

chief_poseidon() {
  local verb="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "${verb}" in
    set)
      [[ -n "${1:-}" ]] || { echo "Uso: ./poseidon chief set <account-id>" >&2; return 2; }
      agents_poseidon chief-set "$1"
      ;;
    *) echo "Uso: ./poseidon chief set <account-id>" >&2; return 2 ;;
  esac
}

tools_poseidon() {
  local verb="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "${verb}" in
    e2e)
      [[ -x "${POSEIDON_ROOT}/tools/e2e/doctor.sh" ]] || chmod +x "${POSEIDON_ROOT}/tools/e2e/doctor.sh"
      "${POSEIDON_ROOT}/tools/e2e/doctor.sh"
      ;;
    *) echo "Uso: ./poseidon tools e2e" >&2; return 2 ;;
  esac
}

status_poseidon() {
  recover_stale_state
  if ! is_running; then echo "Poseidon: parado"; return 1; fi
  local address
  address="$(json_string address)"
  if operational_probe "${address}"; then
    echo "Poseidon: operacional em ${address} (readiness: ${POSEIDON_PROBE_MODE})"
    [[ -s "${POSEIDON_PORT_FILE}" ]] && echo "Porta fixa: $(tr -d '[:space:]' < "${POSEIDON_PORT_FILE}")"
    echo "Launcher PID: $(json_number launcherPid); Runner PID: $(json_number runnerPid)"
  else
    echo "Poseidon: processo ativo, APIs essenciais indisponíveis: ${POSEIDON_PROBE_ERROR}" >&2
    return 2
  fi
}

doctor_poseidon() {
  local failures=0
  echo "Poseidon doctor"
  [[ "$(uname -s)" == "Darwin" ]] && echo "[ok] macOS $(sw_vers -productVersion)" || { echo "[erro] macOS obrigatório"; failures=$((failures+1)); }
  [[ -d "${POSEIDON_DATA_DIR}" || -w "$(dirname "${POSEIDON_DATA_DIR}")" ]] && echo "[ok] diretório de dados gravável" || { echo "[erro] diretório de dados sem escrita"; failures=$((failures+1)); }
  if [[ -x "${POSEIDON_ROOT}/Harness.Launcher" ]]; then
    [[ "$(uname -m)" == "arm64" ]] && echo "[ok] arquitetura Apple Silicon" || { echo "[erro] pacote osx-arm64 incompatível com $(uname -m)"; failures=$((failures+1)); }
    [[ -x "${POSEIDON_ROOT}/runner/Harness.Runner" ]] && echo "[ok] pacote self-contained completo" || { echo "[erro] Runner ausente"; failures=$((failures+1)); }
    [[ -x "${POSEIDON_ROOT}/Harness.Bruna.Desktop" || -x "${POSEIDON_ROOT}/Harness.Bruna.Desktop.exe" ]] && echo "[ok] Bruna Desktop Companion presente" || { echo "[erro] Bruna Desktop Companion ausente"; failures=$((failures+1)); }
    [[ -s "${POSEIDON_ROOT}/wwwroot/index.html" ]] && echo "[ok] frontend empacotado" || { echo "[erro] frontend ausente"; failures=$((failures+1)); }
  else
    [[ -x "${POSEIDON_ROOT}/tools/backend/dotnet.sh" ]] && echo "[ok] SDK .NET versionado" || { echo "[erro] SDK .NET ausente"; failures=$((failures+1)); }
    command -v node >/dev/null && echo "[ok] Node $(node --version)" || { echo "[erro] Node ausente"; failures=$((failures+1)); }
    if command -v docker >/dev/null && docker info >/dev/null 2>&1; then echo "[ok] Docker/Colima disponível"; else echo "[info] Docker/Colima indisponível; recursos isolados ficam desabilitados"; fi
  fi
  if command -v omp >/dev/null; then
    echo "[info] executor OMP disponível, mas só é ativado por configuração explícita"
  else
    echo "[info] executor OMP opcional indisponível; o Poseidon continua funcional"
  fi
  df -h "$(dirname "${POSEIDON_DATA_DIR}")" | tail -1 | awk '{print "[info] disco disponível: "$4}'
  if is_running; then status_poseidon || failures=$((failures+1)); else echo "[info] Poseidon parado"; fi
  echo "[info] dados: ${POSEIDON_DATA_DIR}"
  echo "[info] logs: ${POSEIDON_LOG_DIR}"
  [[ ${failures} -eq 0 ]]
}

# ---------------------------------------------------------------------------
# Auto-update (G-AUTOUPDATE): detecção de nova versão + gatilho reusando a
# maquinaria de update do Launcher (verificação de integridade, backup offline,
# troca por rename e rollback automático). Só disponível na instalação
# empacotada, onde ${POSEIDON_ROOT} é o próprio diretório de instalação e o
# recibo gerenciado existe. A fonte da versão nova é um diretório de pacote
# publicado, informado por --source ou pelo arquivo update-source.json no data
# dir. Não há servidor remoto de update por ora (ver docs/.../DESKTOP.md).
# ---------------------------------------------------------------------------
resolve_installed_launcher() {
  if [[ -x "${POSEIDON_ROOT}/Harness.Launcher" ]]; then
    echo "${POSEIDON_ROOT}/Harness.Launcher"
    return 0
  fi
  echo "As atualizações self-service só existem na instalação empacotada (Harness.Launcher ausente)." >&2
  return 2
}

check_update_poseidon() {
  local launcher
  launcher="$(resolve_installed_launcher)" || return 2
  "${launcher}" check-update \
    --install-dir "${POSEIDON_ROOT}" --data-dir "${POSEIDON_DATA_DIR}" "$@"
}

update_poseidon() {
  local launcher
  launcher="$(resolve_installed_launcher)" || return 2
  # Update muta a instalação: exige o Launcher encerrado. Encerra de forma graciosa se no ar.
  if is_running; then
    echo "Encerrando o Poseidon para aplicar a atualização…"
    stop_poseidon
  fi
  "${launcher}" self-update \
    --install-dir "${POSEIDON_ROOT}" --data-dir "${POSEIDON_DATA_DIR}" "$@"
}

bruna_poseidon() {
  local bruna_path="${POSEIDON_ROOT}/Harness.Bruna.Desktop"
  [[ -x "${bruna_path}" ]] || bruna_path="${POSEIDON_ROOT}/Harness.Bruna.Desktop.exe"
  if [[ ! -x "${bruna_path}" ]]; then
    echo "Bruna Desktop Companion não encontrado em ${POSEIDON_ROOT}." >&2
    echo "Verifique se a instalação foi feita a partir de um pacote publicado." >&2
    return 2
  fi
  local args=(--data-dir "${POSEIDON_DATA_DIR}")
  # Forward any extra arguments (e.g. --install-dir) to the companion.
  [[ $# -eq 0 ]] || args+=("$@")
  nohup "${bruna_path}" "${args[@]}" >/dev/null 2>&1 &
  echo "Bruna Desktop Companion iniciada."
}

case "${1:-}" in
  start) shift; start_poseidon "$@" ;;
  status) status_poseidon ;;
  stop) stop_poseidon ;;
  restart) shift; stop_poseidon; start_poseidon "$@" ;;
  check-update) shift; check_update_poseidon "$@" ;;
  update) shift; update_poseidon "$@" ;;
  doctor) doctor_poseidon ;;
  agent) shift; agent_poseidon "$@" ;;
  agents) shift; agents_poseidon "$@" ;;
  chief) shift; chief_poseidon "$@" ;;
  graph) shift; graph_poseidon "$@" ;;
  tools) shift; tools_poseidon "$@" ;;
  logs) mkdir -p "${POSEIDON_LOG_DIR}"; [[ "${2:-}" == "--follow" ]] && exec tail -f "${POSEIDON_HOST_LOG}" || { echo "Logs: ${POSEIDON_LOG_DIR}"; tail -n 200 "${POSEIDON_HOST_LOG}" 2>/dev/null || true; } ;;
  bruna) shift; bruna_poseidon "$@" ;;
  release-candidate) [[ -x "${POSEIDON_ROOT}/tools/backend/verify-release-candidate.sh" ]] || { echo "Comando disponível apenas no checkout de desenvolvimento." >&2; exit 2; }; exec "${POSEIDON_ROOT}/tools/backend/verify-release-candidate.sh" ;;
  *) usage; exit 2 ;;
esac
