{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poseidon.local/schemas/governance-manifest-v1.json",
  "title": "Poseidon governance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "lastGeneratedAt",
    "tokenBudget",
    "knownOwners",
    "markdownAllowlist",
    "documents"
  ],
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lastGeneratedAt": { "type": "string", "format": "date-time" },
    "tokenBudget": { "type": "integer", "minimum": 1 },
    "knownOwners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "markdownAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "path", "title", "category", "topic", "authority", "scope",
        "audience", "providers", "agents", "workflows", "phases", "taskTypes",
        "riskTiers", "pathGlobs", "loadPolicy", "priority", "tokenEstimate",
        "owner", "status", "version", "lastVerifiedAt", "reviewDueAt",
        "supersedes", "dependencies", "related", "enforcedBy", "checksum",
        "containsSecrets", "generated", "sourceOfTruth"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "authority": {
          "enum": ["canonical", "adapter", "generated", "operational", "reference", "evidence", "historical"]
        },
        "scope": { "type": "string", "minLength": 1 },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["human", "agent", "runtime"] }
        },
        "providers": { "$ref": "#/$defs/stringArray" },
        "agents": { "$ref": "#/$defs/stringArray" },
        "workflows": { "$ref": "#/$defs/stringArray" },
        "phases": { "$ref": "#/$defs/stringArray" },
        "taskTypes": { "$ref": "#/$defs/stringArray" },
        "riskTiers": { "$ref": "#/$defs/stringArray" },
        "pathGlobs": { "$ref": "#/$defs/stringArray" },
        "loadPolicy": { "enum": ["always", "entry", "bundle", "on-demand", "never"] },
        "priority": { "type": "integer", "minimum": 0 },
        "tokenEstimate": { "type": "integer", "minimum": 0 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "draft", "deprecated", "superseded", "historical"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "reviewDueAt": { "type": ["string", "null"], "format": "date-time" },
        "supersedes": { "$ref": "#/$defs/stringArray" },
        "dependencies": { "$ref": "#/$defs/stringArray" },
        "related": { "$ref": "#/$defs/stringArray" },
        "enforcedBy": { "$ref": "#/$defs/stringArray" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "containsSecrets": { "const": false },
        "generated": { "type": "boolean" },
        "sourceOfTruth": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+$" }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
