# Modo da camada de dados: "mock" (default) usa MockApiClient + fixtures em memória;
# "http" usa HttpApiClient + SignalRRealtimeClient contra o backend real.
VITE_API_MODE=mock

# Base URL do backend — obrigatória quando VITE_API_MODE=http.
# VITE_API_BASE_URL=https://localhost:5001

# "on" sobe o worker msw em dev para servir as fixtures via HTTP (/api/v1)
# e permitir inspeção de tráfego no navegador. Testes não usam rede.
# VITE_MSW=off

# Flag operacional da UI contract-first. O perfil `npm run dev:real` usa `on`
# por padrão após o Gate P1; defina `off` para rollback à auditoria legada.
# O modo mock permanece `off` e nunca simula dados P1.
VITE_GOVERNANCE_CONTRACT_UI=off
