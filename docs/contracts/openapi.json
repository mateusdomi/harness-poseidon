{
    "openapi": "3.1.1",
    "info": {
        "title": "Harness API",
        "version": "1.0.0"
    },
    "paths": {
        "/health": {
            "get": {
                "tags": [
                    "system"
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/event-streams/snapshot": {
            "get": {
                "tags": [
                    "events"
                ],
                "parameters": [
                    {
                        "name": "stream",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "afterSequence",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EventStreamSnapshot"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/profiles/current": {
            "get": {
                "tags": [
                    "profiles"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfileResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/profiles": {
            "get": {
                "tags": [
                    "profiles"
                ],
                "parameters": [
                    {
                        "name": "cursor",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "pattern": "^-?(?:0|[1-9]\\d*)$",
                            "type": [
                                "integer",
                                "string"
                            ],
                            "format": "int32"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfilePage"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "profiles"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProfileRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfileResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/profiles/{profileId}": {
            "patch": {
                "tags": [
                    "profiles"
                ],
                "parameters": [
                    {
                        "name": "profileId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfileResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateProfileRequest": {
                "required": [
                    "displayName",
                    "email",
                    "avatarUrl",
                    "locale"
                ],
                "type": "object",
                "properties": {
                    "displayName": {
                        "type": "string"
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "avatarUrl": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "locale": {
                        "type": "string"
                    }
                }
            },
            "EventStreamSnapshot": {
                "required": [
                    "stream",
                    "sequence",
                    "latestByType",
                    "delta"
                ],
                "type": "object",
                "properties": {
                    "stream": {
                        "type": "string"
                    },
                    "sequence": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "latestByType": {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#/components/schemas/RealtimeEventEnvelope"
                        }
                    },
                    "delta": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RealtimeEventEnvelope"
                        }
                    }
                }
            },
            "JsonElement": {},
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "ProfilePage": {
                "required": [
                    "items",
                    "nextCursor"
                ],
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProfileResponse"
                        }
                    },
                    "nextCursor": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "ProfileResponse": {
                "required": [
                    "id",
                    "displayName",
                    "email",
                    "avatarUrl",
                    "locale",
                    "createdAt",
                    "lastActiveAt"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "avatarUrl": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "locale": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "lastActiveAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "RealtimeEventEnvelope": {
                "required": [
                    "stream",
                    "sequence",
                    "type",
                    "occurredAt",
                    "payload"
                ],
                "type": "object",
                "properties": {
                    "stream": {
                        "type": "string"
                    },
                    "sequence": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "type": {
                        "type": "string"
                    },
                    "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "payload": {
                        "$ref": "#/components/schemas/JsonElement"
                    }
                }
            },
            "UpdateProfileRequest": {
                "type": "object",
                "properties": {
                    "displayName": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "avatarUrl": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "locale": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "tags": [
        {
            "name": "system"
        },
        {
            "name": "events"
        },
        {
            "name": "profiles"
        }
    ]
}
